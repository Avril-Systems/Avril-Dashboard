NEXT_PUBLIC_CONVEX_URL=
# Public site URL of the Convex deployment (https://<deployment>.convex.site).
NEXT_PUBLIC_CONVEX_SITE_URL=
# Server-side fallback for NEXT_PUBLIC_CONVEX_URL (used by src/lib/convexServer.ts).
CONVEX_URL=
# Deployment slug only, e.g. dev:happy-animal-123 — never paste dashboard URLs or tokens after a |
CONVEX_DEPLOYMENT=
# Shared secret for Next.js API → Convex (serverChats, bootstrap). Generate once, set in Convex AND .env.local:
#   openssl rand -base64 32
#   npx convex env set CONVEX_SERVER_SECRET "<paste-here>"
CONVEX_SERVER_SECRET=
# Convex-runtime only (set via `npx convex env set`, NOT in .env). Used by convex/deployments.ts.
# CONVEX_SITE_URL=
# DEPLOYER_CALLBACK_URL=
# DEPLOYER_CALLBACK_SECRET=
# OPENCLAW_DEPLOYER_URL=
# OPENCLAW_DEPLOYER_TOKEN=
# OPENCLAW_DEPLOY_MOCK=false
HUMAN_TECH_PROJECT_ID=
HUMAN_TECH_CLIENT_ID=
HUMAN_TECH_CLIENT_SECRET=
AA_PROVIDER_API_KEY=
SENTRY_DSN=
DASHBOARD_APP_TOKEN=
NEXT_PUBLIC_DASHBOARD_APP_TOKEN=
# Dev-only: bypass API auth (src/lib/apiSecurity.ts). Keep disabled (false) in production.
DEMO_BYPASS_ENABLED=false
DEMO_BYPASS_KEY=
# HMAC secret for the wallet sign-in session cookie (ad_session). Generate once:
#   openssl rand -base64 32
DASHBOARD_SESSION_SECRET=
# RAG service for "Generate opportunities". Empty/unset falls back to mock opportunities.
RAG_SERVICE_BASE_URL=
# Set true to force the offline mock (getMockOpportunities) instead of the RAG service.
MOCK_RAG_OPPORTUNITIES=false
# Port for the mock RAG/Launch server (script/mock-rl-server.mjs). Script-only.
# MOCK_RL_PORT=15999
OPENCLAW_BRIDGE_URL=
OPENCLAW_ALLOWED_BRIDGE_URL=https://openclaw.agents.motusdao.org/respond
OPENCLAW_BRIDGE_TOKEN=
# `next dev` only: use local bridge so chat/spawn work without public OpenClaw DNS
# OPENCLAW_BRIDGE_URL_DEV=http://127.0.0.1:8787/respond
# OpenClaw control-plane gateway (WebSocket client + /api/orchestration/health).
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_CLIENT_ID=openclaw-control-ui
# Local bridge server (bridge/openclaw-bridge.mjs). Script-only.
# OPENCLAW_BRIDGE_PORT=8787
# OPENCLAW_BRIDGE_ROUTE=/respond
# OPENCLAW_BRIDGE_TO=+19999999999
# OPENCLAW_BRIDGE_TIMEOUT_SEC=90
# OPENCLAW_BRIDGE_MAX_CONTEXT_CHARS=12000
# Venice chat inference (app/api/chat/*, convex/lib/venice.ts).
VENICE_INFERENCE_KEY=
VENICE_ADMIN_KEY=
VENICE_INFERENCE_URL=https://api.venice.ai/api/v1/chat/completions
VENICE_MODEL=venice-uncensored
NEXT_PUBLIC_OWNER_WALLET=
NEXT_PUBLIC_WAAP_LOGO=
# WalletConnect Cloud project id for the wallet sign-in (src/components/WaaPProvider.tsx).
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# MotusNS registry address for agent name resolution (src/lib/motusns.ts).
NEXT_PUBLIC_MOTUSNS_REGISTRY_ADDRESS=0x3a529655e45f2Cc194233b4Ec1BF3Fc0B3C8Fd10
# ERC-8004 agent identity (Celo). Production: https://app.avril.life
NEXT_PUBLIC_APP_URL=https://app.avril.life
NEXT_PUBLIC_AGENT_REGISTRATION_URI=https://app.avril.life/agent-registration.json
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
# Startup Agent Generator (Prism + ENS + ERC-8004 optional hooks)
PRISM_KEYS_DIR=~/.config/prism/keys
PRISM_ROOT_KEY_PATH=~/.config/prism/keys/root-wallet.json
PRISM_ROOT_PRIVATE_KEY=
PRISM_FACTORY_ADDRESS=
PRISM_CONTEXT_ADDRESS=
ENS_REGISTRY_ADDRESS=
STARTUP_AGENT_DEFAULT_FUNDING_CELO=0.01
STARTUP_AGENT_REGISTER_8004=0
# Script-only (script/startup-agent-generator.mjs): defaults when unset.
# CELO_CHAIN_ID=42220
# CELO_RPC_URL=https://forno.celo.org
ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
STARTUP_AGENT_8004_URI_BASE=https://app.avril.life
# After first onchain registration, set for domain proof at /.well-known/agent-registration.json
NEXT_PUBLIC_ERC8004_AGENT_ID=
NEXT_PUBLIC_ERC8004_AGENT_OWNER=
NEXT_PUBLIC_PASSPORT_EMBED_API_KEY=
NEXT_PUBLIC_PASSPORT_SCORER_ID=

# Stripe checkout (sandbox). Use CHECKOUT_MODE=mock to skip hosted Checkout.
CHECKOUT_MODE=mock
NEXT_PUBLIC_CHECKOUT_MODE=mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# ---------------------------------------------------------------------------
# Stripe webhook setup (needed for recovery + double-charge protection).
#
# The happy path (pay -> redirect back to /billing/success) works WITHOUT the
# webhook: /api/billing/verify checks the Stripe session directly and
# /api/deploy/launch reconciles the deploymentIntent to paid before consuming.
#
# The webhook is REQUIRED for:
#   - Payments with a lost redirect (user closes the tab before returning).
#   - The "Reutilizar este pago" recovery panel (/api/billing/intents lists
#     deploymentIntents in status 'paid').
#   - The real anti-double-charge guarantee across sessions.
#
# Local dev (Stripe CLI):
#   1. Install:  brew install stripe/stripe-cli/stripe        (macOS)
#                or download from https://github.com/stripe/stripe-cli/releases (Linux)
#   2. Authenticate with the SAME account as STRIPE_SECRET_KEY:  stripe login
#   3. Tunnel webhook events to the app:
#                stripe listen --forward-to localhost:3000/api/billing/webhook
#   4. Paste the printed whsec_... here and restart `next dev`.
#
# Production (Stripe Dashboard):
#   1. Developers -> Webhooks -> Add endpoint:
#      URL = https://<your-domain>/api/billing/webhook
#   2. Subscribe events: checkout.session.completed,
#      checkout.session.async_payment_succeeded
#   3. Set the Signing secret (whsec_...) here in the production env and redeploy.
#   4. Ensure the Convex schema/functions exist in the production deployment:
#      npx convex deploy   (creates the deploymentIntents table + serverBilling)
#
# Test payment: card 4242 4242 4242 4242, any future expiry, any CVC.
# ---------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=

# Launch deploy API. Called by POST /api/deploy/launch ONLY after a paid Stripe
# checkout session. When LAUNCH_DEPLOY_ENABLED=false the deploy call is skipped.
LAUNCH_API_URL=
LAUNCH_API_TOKEN=
LAUNCH_DEPLOY_ENABLED=false

# Server-side Passport score verification (recommended)
PASSPORT_API_KEY=
PASSPORT_SCORER_ID=
PASSPORT_SCORE_THRESHOLD=20
