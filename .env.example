# --- Inferencia genérica (API compatible con OpenAI) ---
# Base URL sin /chat/completions (o la URL completa). Ej: https://api.openai.com/v1
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=
# Opcional
INFERENCE_TEMPERATURE=0.45
INFERENCE_TIMEOUT_MS=60000
# Venice y OpenClaw/bridge son opcionales: se usan solo si se piden o si no hay
# proveedor genérico configurado. Ver docs/INFERENCE_PROVIDER.md.

NEXT_PUBLIC_CONVEX_URL=
# Deployment slug only, e.g. dev:happy-animal-123 — never paste dashboard URLs or tokens after a |
CONVEX_DEPLOYMENT=
# Shared secret for Next.js API → Convex (serverChats, bootstrap). Generate once, set in Convex AND .env.local:
#   openssl rand -base64 32
#   npx convex env set CONVEX_SERVER_SECRET "<paste-here>"
CONVEX_SERVER_SECRET=
# --- Swarmy S00 (solo nombres; los valores van en .env.local, nunca en el repo) ---
SWARMY_CONVEX_URL=
SWARMY_CONVEX_SERVER_SECRET=
SWARMY_TENANT_ID=
SWARMY_WORKSPACE_ID=
# Opcional: token de GitHub para el worker de prospección (nunca commitear el valor)
GITHUB_TOKEN=
# Arneses originales (solo nombres; los valores van en .env.local)
# Marketing original (Iván): NVIDIA NIM + búsqueda opcional
NVIDIA_API_KEY=
BRAVE_API_KEY=
# Modelo alternativo para el arnés de marketing (opcional)
MODELO_LLM=
# B2B original en modo "modelo" (opcional; el modo reglas no la necesita)
ANTHROPIC_API_KEY=
# Intérprete Python con dependencias de harness/original/marketing (opcional;
# por defecto el worker usa .harness-venv/bin/python si existe)
HARNESS_PYTHON=

HUMAN_TECH_PROJECT_ID=
HUMAN_TECH_CLIENT_ID=
HUMAN_TECH_CLIENT_SECRET=
AA_PROVIDER_API_KEY=
SENTRY_DSN=
DASHBOARD_APP_TOKEN=
NEXT_PUBLIC_DASHBOARD_APP_TOKEN=
# Operadores de Swarmy con sesión: wallets separadas por coma (0x...). Si está vacío,
# las sesiones no tienen acceso de operador; el token de servidor sigue funcionando.
SWARMY_OPERATOR_WALLETS=
OPENCLAW_BRIDGE_URL=
OPENCLAW_ALLOWED_BRIDGE_URL=https://openclaw.agents.motusdao.org/respond
OPENCLAW_BRIDGE_TOKEN=
# `next dev` only: use local bridge so chat/spawn work without public OpenClaw DNS
# OPENCLAW_BRIDGE_URL_DEV=http://127.0.0.1:8787/respond
NEXT_PUBLIC_OWNER_WALLET=
NEXT_PUBLIC_WAAP_LOGO=
# ERC-8004 agent identity (Celo). Production: https://app.avril.life
NEXT_PUBLIC_APP_URL=https://app.avril.life
NEXT_PUBLIC_AGENT_REGISTRATION_URI=https://app.avril.life/agent-registration.json
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
# Startup Agent Generator (Prism + ENS + ERC-8004 optional hooks)
PRISM_KEYS_DIR=~/.config/prism/keys
PRISM_ROOT_KEY_PATH=~/.config/prism/keys/root-wallet.json
PRISM_ROOT_PRIVATE_KEY=
PRISM_FACTORY_ADDRESS=
PRISM_CONTEXT_ADDRESS=
ENS_REGISTRY_ADDRESS=
STARTUP_AGENT_DEFAULT_FUNDING_CELO=0.01
STARTUP_AGENT_REGISTER_8004=0
ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
STARTUP_AGENT_8004_URI_BASE=https://app.avril.life
# After first onchain registration, set for domain proof at /.well-known/agent-registration.json
NEXT_PUBLIC_ERC8004_AGENT_ID=
NEXT_PUBLIC_ERC8004_AGENT_OWNER=
NEXT_PUBLIC_PASSPORT_EMBED_API_KEY=
NEXT_PUBLIC_PASSPORT_SCORER_ID=

# Stripe checkout (sandbox). Use CHECKOUT_MODE=mock to skip hosted Checkout.
CHECKOUT_MODE=mock
NEXT_PUBLIC_CHECKOUT_MODE=mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# NEXT_PUBLIC_APP_URL=http://localhost:3000  # override solo en dev; en producción usa la URL real

# Server-side Passport score verification (recommended)
PASSPORT_API_KEY=
PASSPORT_SCORER_ID=
PASSPORT_SCORE_THRESHOLD=20

DASHBOARD_SESSION_SECRET=

# Swarmy Orchestration Worker (W46)
# Optional alias if running worker outside Next.js (falls back to NEXT_PUBLIC_CONVEX_URL)
CONVEX_URL=
# External DeepSeek adapter endpoint (if unset, worker reports status BLOCKED)
DEEPSEEK_ADAPTER_URL=
# Scheduler periódico de metacognición en el worker (opcional; el worker opera sin esto)
# App URL del Dashboard y token de operador para disparar /api/orchestration/metacognition/run
METACOGNITION_APP_URL=
METACOGNITION_INTERVAL_MS=3600000
